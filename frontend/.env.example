# Backend API base URL (must include the /api suffix)
REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: websocket base URL. If unset, it's derived automatically from
# REACT_APP_API_BASE_URL (http->ws, /api suffix stripped).
REACT_APP_WS_BASE_URL=ws://127.0.0.1:8000

# Google OAuth 2.0 -> Web application client ID (public, not secret; must
# match the backend's GOOGLE_OAUTH_CLIENT_ID)
REACT_APP_GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
