# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google Calendar refresh-token encryption key (M-2) -> independent of
# DJANGO_SECRET_KEY on purpose. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated to support rotation (new key first); see
# booking/management/commands/rotate_calendar_key.py.
# NOTE: deploying this for the first time invalidates any Calendar
# credential encrypted under the old scheme (derived from SECRET_KEY) —
# reconnect once via /admin-tools/google-calendar/connect/ after deploying.
CALENDAR_TOKEN_KEY=replace-with-a-generated-fernet-key

# Comma-separated list of origins the frontend is served from (must include scheme)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list of origins trusted for cross-site POSTs, e.g. /admin/ login (must include scheme)
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_NAME=crm_booking
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
# require | prefer | disable | verify-ca | verify-full
DB_SSLMODE=require

# Google OAuth 2.0 -> Web application client ID
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Calendar sync (business account) -> see GOOGLE_CALENDAR_SETUP.md
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/admin-tools/google-calendar/callback/
GOOGLE_CALENDAR_ID=primary

# Email (SMTP) -> Brevo relay. Host/port/TLS default to the Brevo relay in
# settings.py; override here only if needed.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Brevo SMTP login and SMTP master key (starts with "xsmtpsib-"), from
# Brevo -> SMTP & API -> SMTP. NOT a mailbox password.
EMAIL_HOST_USER=replace-with-brevo-smtp-login
EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-master-key
# Must be a sender verified in the Brevo account (Senders, Domains & Dedicated IPs).
DEFAULT_FROM_EMAIL=CRM & Booking <verified-sender@your-domain.com>
# Optional: Reply-To for transactional mail; defaults to DEFAULT_FROM_EMAIL.
# EMAIL_REPLY_TO=CRM & Booking <verified-sender@your-domain.com>
# Optional: From address for CRM-admin / security-alert mail (mail_admins).
# Defaults to DEFAULT_FROM_EMAIL; set to a distinct verified Brevo sender to
# keep operational alerts separate from customer-facing transactional mail.
# SERVER_EMAIL=CRM Alerts <alerts@your-domain.com>

# Security alerting (SecurityFeatures.md F-9) -> comma-separated email
# addresses that receive alerts (failed-login bursts, authorization
# denials, role changes, invoice void/refund, booking-cancellation
# spikes). Delivered via the SMTP settings above. Empty/unset = alerting
# is off.
SECURITY_ALERT_EMAILS=

# Off-box security log shipping (SecurityFeatures.md F-9) -> optional.
# Leave unset to keep logs on stdout only (current default). Set to an
# Azure Application Insights / Log Analytics connection string
# ("InstrumentationKey=...;IngestionEndpoint=https://...") to also ship
# the `security` and `django` loggers there.
AZURE_LOG_ANALYTICS_CONNECTION_STRING=
