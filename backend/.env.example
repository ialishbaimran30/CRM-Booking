# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=crm_booking
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Google OAuth 2.0 -> Web application client ID
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Calendar sync (business account) -> see GOOGLE_CALENDAR_SETUP.md
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/admin-tools/google-calendar/callback/
GOOGLE_CALENDAR_ID=primary

# Email (SMTP) -> Gmail account used to send outgoing mail
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-gmail-app-password
# Optional: defaults to "CRM & Booking <EMAIL_HOST_USER>" if not set
DEFAULT_FROM_EMAIL=CRM & Booking <your-email@gmail.com>
