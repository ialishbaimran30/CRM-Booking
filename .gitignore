# ─── Secrets / environment ────────────────────────────────────────────────
# Never commit real environment files. Only *.env.example is tracked.
.env
.env.*
*.env
!.env.example
!*/.env.example

# Credentials / key material
*.pem
*.key
*.p12
*.pfx
*.pkcs12
id_rsa
id_rsa.*
*.keystore
credentials.json
client_secret*.json
service-account*.json

# ─── Claude Code working files ────────────────────────────────────────────
# Local memory / audit notes are intentionally NOT published to the repo.
# Skills (.claude/skills/) and agents (.claude/agents/) ARE tracked.
.claude/memory/
.claude/settings.local.json
.claude/.credentials.json

# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.sqlite3
.venv/
venv/
env/
staticfiles/
media/

# ─── Node / frontend build ───────────────────────────────────────────────
node_modules/
/frontend/build/
/frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / editor ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
